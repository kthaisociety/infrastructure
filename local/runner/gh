#!/usr/bin/env bash
# Stands in for the GitHub CLI in local jobs. Only `gh api <path> [--jq <expr>]`, anonymously: what
# deploy.yml's production check reads (a public repo's releases and commits). It never holds a token.
set -euo pipefail

if [ "${1:-}" != api ] || [ -z "${2:-}" ]; then
  echo "local gh: only 'gh api <path> [--jq <expr>]' is available here" >&2
  exit 2
fi
path=$2
shift 2
jq_expr=.
while [ $# -gt 0 ]; do
  case $1 in
    --jq) jq_expr=$2; shift 2 ;;
    *) echo "local gh: unsupported argument '$1'" >&2; exit 2 ;;
  esac
done

curl -sSf -H 'Accept: application/vnd.github+json' "https://api.github.com/${path#/}" | jq -r "$jq_expr"
